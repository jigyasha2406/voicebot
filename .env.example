# Copy this file to .env and add your own keys. Never share or commit .env.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo

# Text to speech: "elevenlabs", "sarvam" or "browser" (free, no key). Falls back to "browser" if no key is set.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_FORMAT=mp3_22050_32

SARVAM_API_KEY=
SARVAM_SPEAKER=anushka
SARVAM_MODEL=bulbul:v2

# Speed knobs
LLM_MAX_TOKENS=90
STT_LANGUAGE=
SARVAM_SAMPLE_RATE=16000

# Slow-reply protection: start a duplicate request if a step takes longer than this (seconds)
STT_HEDGE_SECONDS=0.6
TTS_HEDGE_SECONDS=0.55

# --- MySQL database (seats, opening hours, bookings) -------------------------
# Install MySQL (or MariaDB), start it, and put your login here. The database and tables are created automatically.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=cafe_voice_bot

# --- Cafe seat booking ------------------------------------------------------
CAFE_NAME=Brew & Bloom Cafe
CAFE_TZ=Asia/Kolkata
# Default opening hours. They are copied into the database the first time the app runs;
# after that change them with PUT /api/cafe/hours/{weekday} (or edit the opening_hours table in MySQL).
CAFE_OPEN=09:00
CAFE_CLOSE=22:00
BOOKING_MINUTES=90        # how long a booked table is held
SLOT_STEP=30              # alternative times are offered every 30 minutes
MIN_STAY_MINUTES=45       # last booking starts at least this long before closing
MIN_LEAD_MINUTES=15       # same-day bookings need this much notice
MAX_PARTY=12
MAX_DAYS_AHEAD=30
VOICE_ONLY_BOOKING=true   # true: bookings only by microphone. false: typing also works (handy for testing)
ADMIN_TOKEN=              # optional: if set, seat/hours edits and admin cancel need header X-Admin-Token

